<odoo>
  <data>

    <record id="sale_order_warning_wizard" model="ir.ui.view">
        <field name="name">Warning</field>
        <field name="model">sale.order.warning.wizard</field>
        <field name="arch" type="xml">
            <form string="Warning">
                <group>
                    <field name="message" />
                </group>
                <footer>
                    <button name="disable_warning" string="Ok" type="object" class="oe_highlight"/>
                    <button name="cancel" string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

  </data>
</odoo>
